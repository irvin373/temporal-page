---
import { Image } from "astro:assets";
import Layout from '../layouts/Layout.astro';
import innovative from '../assets/innovative.webp'
import officers from '../assets/officers.webp'
import footerAbout from '../assets/footerAbout.png'
---

<Layout 
	title="About Us - Element Safety LLC" 
	description="Learn about Element Safety LLC's experienced team, qualifications, and commitment to providing exceptional environmental health and safety consulting services."
>
	<!-- About Hero -->
	<section class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-2xl md:text-2xl font-semibold mb-6">ABOUT US</h1>
			<p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto font-bold">Building safer projects through experience, leadership and prevention</p>
			<p class="text-base md:text-lg text-blue-100 max-w-3xl mx-auto mt-4">
				At Element Safety, we partner with organizations to create safer, more efficient workplaces through proactive safety management and industry expertise. Our mission is simple: help teams prevent incidents, stay compliant, and operate with confidence.
			</p>
		</div>
	</section>

	<!-- WHO WE ARE Section - -->
	<section class="py-0 bg-white overflow-hidden">
		<div class="flex flex-col lg:flex-row lg:justify-between">
			<div class="lg:w-1/2 px-4 sm:px-6 lg:px-8 lg:pr-12 flex flex-col justify-center py-12 lg:py-0">
				<p class="text-sm font-bold tracking-wider uppercase text-gray-900 mb-3">WHO WE ARE</p>
				<h2 class="text-3xl font-bold text-gray-900 mb-4">
					Safety professionals who understand real jobsite challenges
				</h2>
				<p class="text-gray-700">
					Element Safety LLC was built to support companies that need more than basic compliance. We combine hands-on industry experience with strategic safety leadership to help clients reduce risk, improve operations, and strengthen workplace safety culture.
					From construction and industrial projects to long-term EHS support, our team works closely with clients to deliver practical and scalable safety solutions.
				</p>
			</div>
			
			<div class="lg:flex lg:justify-end lg:ml-auto mt-8 lg:mt-0">
				<div style="width: 624px; height: 555px;" class="flex-none">
					<Image
						src={innovative}
						alt="Safety professionals reviewing plans"
						class="w-full h-full object-cover object-[center_30%]"
						loading="eager"
						format="webp"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- OUR APPROACH Section  -->
	<section class="py-0 bg-white overflow-hidden">
		<div class="flex flex-col lg:flex-row">
			<div class="lg:flex lg:justify-start lg:mr-auto mt-8 lg:mt-0 lg:order-1">
				<div style="width: 624px; height: 565px;" class="flex-none">
					<Image
						src={officers}
						alt="Safety professionals in training"
						class="w-full h-full object-cover"
						loading="eager"
						format="webp"
					/>
				</div>
			</div>
			
			<div class="lg:w-1/2 px-4 sm:px-6 lg:px-8 lg:pl-12 lg:order-2 flex flex-col justify-center py-12 lg:py-0">
				<p class="text-sm font-bold tracking-wider uppercase text-gray-900 mb-2">OUR APPROACH</p>
				<h2 class="text-3xl font-bold text-gray-900 mb-4">
					Proactive safety, not reactive compliance
				</h2>
				<p class="text-base text-gray-700 mb-1">
					We believe effective safety management starts long before incidents happen.
					That's why our approach focuses on:
				</p>
				<ul class="list-disc pl-5 my-4 text-gray-700 space-y-2">
					<li>Early risk identification</li>
					<li>Clear communication and training</li>
					<li>Field-oriented safety leadership</li>
					<li>Continuous improvement and accountability</li>
				</ul>
				<p class="text-gray-700 mt-2">
					By integrating safety into daily operations, we help businesses create safer environments while maintaining productivity and project performance.
				</p>
			</div>
		</div>
	</section>

	<!-- MISSION Section -->
	<section class="py-0 bg-[#1A3DA4] overflow-hidden">
		<div class="flex flex-col lg:flex-row">
			<div class="lg:flex lg:justify-start lg:mr-auto mt-8 lg:mt-0 lg:order-1">
				<div style="width: 756px; height: 533px;" class="flex-none">
					<Image
						src={footerAbout}
						alt="Our Mission"
						class="w-full h-full object-cover"
						loading="eager"
						format="webp"
					/>
				</div>
			</div>
			
			<div class="lg:w-1/2 px-4 sm:px-6 lg:px-8 lg:pl-12 lg:order-2 flex flex-col justify-center py-12 lg:py-0">
				<p class="text-sm font-bold tracking-wider uppercase text-white mb-2">MISSION</p>
				<h2 class="text-3xl font-bold text-white mb-4">
					Our Mission
				</h2>
				<p class="text-base text-white leading-relaxed">
					At Element Safety LLC, we are dedicated to help organizations create safer, more efficient workplaces through proactive safety leadership, compliance support, and practical risk management solutions that protect people, strengthen operations, and support long-term project success.
				</p>
			</div>
		</div>
	</section>
</Layout>