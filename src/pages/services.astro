---
import { Image } from "astro:assets";
import about1 from "../assets/about1.png";
import about2 from "../assets/about2.webp";
import about3 from "../assets/about3.webp";
import about4 from "../assets/about4.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Our Services - Element Safety LLC"
  description="Comprehensive safety consulting services including project safety management, consulting & training, retained safety management, and full-time site safety officers."
>
  <!-- Services Hero -->
  <section
    class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white py-20"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Our Core Services</h1>
      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto font-bold">
       <strong>Comprehensive Safety Solutions Tailored to Your Project</strong>
      </p>
      <p class="text-xl md:text-xl text-blue-100 max-w-3xl mx-auto">
        From on-site safety officers to full program management, Element Safety
        delivers expert support that keeps your people safe, your operations
        compliant, and your projects on track
      </p>
    </div>
  </section>

  <!-- Project Safety Management -->
  <section id="project-safety" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Columna de texto -->
        <div>
          <h2 class="text-4xl font-bold text-gray-900 mb-4">
            Project Safety Management
          </h2>

          <p class="text-gray-700 mb-6">
            Keep your project compliant and your team protected <strong
              class="font-bold">From planning to completion</strong
            >
          </p>

          <p class="text-gray-700 mb-4">
            <strong class="font-bold">What we do:</strong>
          </p>

          <p class="text-gray-700 mb-6">
            We manage every aspect of your project's health and safety
            requirements, providing qualified professionals to handle
            compliance, oversight, and risk prevention.
          </p>

          <p class="text-gray-700 mb-4">
            <strong class="font-semibold text-xl">What we deliver:</strong>
          </p>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg
                  class="w-4 h-4 text-blue-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700"
                >Full safety program design and implementation</span
              >
            </li>
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg
                  class="w-4 h-4 text-blue-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
