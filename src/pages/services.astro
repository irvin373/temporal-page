---
import { Image } from "astro:assets";
import about1 from "../assets/about1.png";
import about2 from "../assets/about2.webp";
import about3 from "../assets/about3.webp";
import about4 from "../assets/about4.webp";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Our Services - Element Safety LLC"
  description="Comprehensive safety consulting services including project safety management, consulting & training, retained safety management, and full-time site safety officers."
>
  <!-- Services Hero -->
  <section
    class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-700 text-white py-20"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Our Core Services</h1>
      <p class="text-xl md:text-2xl text-[#EBF0FF] max-w-3xl mx-auto font-bold">
        <strong>Comprehensive Safety Solutions Tailored to Your Project</strong>
      </p>
      <p class="text-xl md:text-xl text-[#EBF0FF] max-w-3xl mx-auto">
        From on-site safety officers to full program management, Element Safety
        delivers expert support that keeps your people safe, your operations
        compliant, and your projects on track
      </p>
    </div>
  </section>

  <section id="project-safety" class="relative py-10 sm:py-12 lg:py-0 bg-white overflow-hidden lg:min-h-[783px] lg:flex lg:items-center">
    <!-- Grid for perfectly aligned text -->
    <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-12">
        <div class="flex flex-col justify-center py-4 lg:py-8">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-3 lg:mb-4">
            Project Safety Management
          </h2>
          <p class="text-gray-700 mb-6">
            Keep your project compliant and your team protected <strong class="font-bold">From <br />planning to completion</strong>
          </p>
          <p class="text-gray-700 mb-4">
            <strong class="font-bold">What we do:</strong>
          </p>
          <p class="text-gray-700 mb-6">
            We manage every aspect of your project's health and safety
            requirements, providing qualified professionals to handle compliance,
            oversight, and risk prevention.
          </p>
          <p class="text-gray-700 mb-4">
            <strong class="font-semibold text-xl">What we deliver:</strong>
          </p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              </div>
              <span class="text-gray-700">Full safety program design and implementation</span>
            </li>
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              </div>
              <span class="text-gray-700">Qualified on-site safety managers and coordinators</span>
            </li>
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              </div>
              <span class="text-gray-700">Risk assessment and mitigation strategies</span>
            </li>
            <li class="flex items-start">
              <div class="bg-blue-100 rounded-full p-1 mr-3 mt-1 flex-shrink-0">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              </div>
              <span class="text-gray-700">Ongoing monitoring and compliance assurance</span>
            </li>
          </ul>
          <p class="text-gray-700">
            <strong>Our professionals don't just check boxes <br /> They help you prevent incidents, protect your <br /> workforce, and safeguard your reputation.</strong>
          </p>
        </div>
      </div>
    </div>

    <!-- Imagen full-bleed a la derecha para Desktop -->
    <div class="hidden lg:block absolute right-0 top-0 h-full w-[624px]">
      <div class="relative w-full h-full flex flex-col justify-end items-center pb-[47px] px-[83px] overflow-hidden">
        <Image src={about1} alt="Safety professionals reviewing plans" class="absolute inset-0 w-full h-full object-cover object-[center_30%]" loading="eager" format="webp" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        <a href="/contact" class="flex items-center justify-center flex-none w-full max-w-[443.56px] h-[69.69px] border border-transparent text-base sm:text-lg font-medium rounded-md text-white bg-[#309733] hover:bg-[#257d2f] transition-colors duration-200 shadow-lg relative z-10">
          Request a Safety Project Assessment
        </a>
      </div>
    </div>

    <!-- Imagen para Móvil -->
    <div class="block lg:hidden w-full px-4 mt-6">
      <div class="relative w-full h-[300px] sm:h-[400px] flex flex-col justify-end items-center pb-6 sm:pb-8 px-3 sm:px-4 overflow-hidden rounded-lg shadow-xl">
        <Image src={about1} alt="Safety professionals reviewing plans" class="absolute inset-0 w-full h-full object-cover object-[center_30%]" loading="eager" format="webp" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        <a href="/contact" class="flex items-center justify-center w-full max-w-[90%] sm:max-w-[443px] h-[56px] sm:h-[70px] border border-transparent text-sm sm:text-base font-medium rounded-md text-white bg-[#309733] hover:bg-[#257d2f] transition-colors duration-200 shadow-lg relative z-10">
          Request a Safety Project Assessment
        </a>
      </div>
    </div>
  </section>

  <!-- Safety Consulting & Training -->
  <section id="consulting-training" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        <div class="order-2 lg:order-1 h-full">
          <div
            class="relative h-full min-h-[300px] lg:min-h-[500px] rounded-lg overflow-hidden shadow-xl"
          >
            <Image
              src={about2}
              alt="Safety professionals in training"
              class="absolute top-0 left-0 w-full h-full object-cover"
              loading="eager"
              format="webp"
            />
          </div>
        </div>
        <div class="order-1 lg:order-2 flex flex-col justify-center py-8">
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            Safety Consulting & Training
          </h2>
          <p class="text-xl text-gray-700 mb-0">
            <strong>Expert Guidance • Smarter Training • Safer Teams</strong>
          </p>
          <p class="text-base text-semibold text-gray-700 mt-0.5 mb-6">
            Build a strong safety culture and achieve compliance with confidence
          </p>
          <p class="text-lg text-gray-700 mb-6">
            We offer complete confined space attendant and confined space rescue
            and standby services. <br /> We will also work with your managers, safety
            staff and line personnel to identify and help prevent problems before
            they occur.
          </p>

          <p class="text-gray-700 mb-4">
            <strong class="font-semibold text-xl"
