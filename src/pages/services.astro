                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700"
                >Behavior-Based Safety (BBS) programs</span
              >
            </li>
            <li class="flex items-start">
              <div class="bg-green-100 rounded-full p-1 mr-3 mt-1">
                <svg
                  class="w-4 h-4 text-green-600"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                    clip-rule="evenodd"></path>
                </svg>
              </div>
              <span class="text-gray-700"
                >Culture transformation strategies & safe behavior initiatives</span
              >
            </li>
          </ul>
          <div class="flex justify-center mt-8">
            <a
              href="/contact"
              class="flex flex-col justify-between items-center px-4 sm:px-[64.97px] py-[21.85px] gap-[5.91px] w-full max-w-[385.68px] h-auto min-h-[71.47px] bg-[#1A3DA4] hover:bg-[#0d235e] text-white text-base sm:text-lg font-medium rounded-[8.86px] transition-colors duration-200 shadow-lg text-center"
            >
              Book a free consultation
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Retained Safety Management -->
  <section id="retained-management" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        <div>
          <h2 class="text-4xl font-bold text-gray-900 mb-6">
            Retained Safety Management
          </h2>
          <p class="text-xl text-gray-600 mb-6">
            <strong>Your Outsourced Safety Department — On Demand</strong>
          </p>
          <p class="text-lg text-semibold text-gray-700 mt-0.5 mb-6">
            Get a dedicated safety management team without increasing your
            internal headcount.
          </p>
          <p class="text-lg text-gray-700 mb-6">
            We work as an extension of your company, handling all HSE operations
            with the same commitment and accountability as your in-house
            department.
          </p>
          <p class="text-gray-700 mb-4">
            <strong class="font-semibold text-xl">We provide:</strong>
          </p>

          <ul class="space-y-4">
            <li class="flex items-start">
              <div class="bg-green-100 rounded-full p-1 mr-3 mt-1">
                <svg
